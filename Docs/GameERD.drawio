yle=none;html=1;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;endSize=20;startSize=20;strokeWidth=3.5;strokeColor=#000000;rounded=1;arcSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="r_player_tutorial_progress_tutorial_id" target="r_video_tutorial_tutorial_id"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="786" y="960.0"/><mxPoint x="786" y="924.0"/></Array></mxGeometry></mxCell><mxCell id="legend" value="&lt;b style='font-size:20px'&gt;How to read this diagram&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; = primary key (underlined) &amp;nbsp; &lt;b&gt;FK&lt;/b&gt; = foreign key&lt;br&gt;Each line runs from a foreign key to the key it references.&lt;br&gt;&lt;br&gt;Line ends (crow's foot notation):&lt;br&gt;&amp;nbsp;&amp;nbsp;two bars &amp;nbsp;= exactly one&lt;br&gt;&amp;nbsp;&amp;nbsp;circle + bar = zero or one&lt;br&gt;&amp;nbsp;&amp;nbsp;circle + crow's foot = zero or many&lt;br&gt;&lt;br&gt;&lt;b&gt;video_tutorial&lt;/b&gt; and &lt;b&gt;player_tutorial_progress&lt;/b&gt; are planned / temporary." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;strokeColor=#000000;strokeWidth=3;fillColor=#ffffff;spacing=14;fontSize=16;" vertex="1" parent="1"><mxGeometry x="3460" y="140" width="1080" height="330" as="geometry"/></mxCell><mxCell id="title" value="Networking Game — Entity Relationship Diagram" style="text;html=1;fontSize=34;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="160" y="40" width="1400" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>