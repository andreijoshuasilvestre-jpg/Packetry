ze=16;labelBackgroundColor=#ffffff;exitX=0.3333;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="d2n4" target="d2n9"><mxGeometry x="-0.080" relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="596"/><mxPoint x="200" y="596"/></Array></mxGeometry></mxCell><mxCell id="d2e20" value="no path" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=10;startArrow=none;strokeWidth=3;strokeColor=#000000;fontColor=#000000;rounded=0;fontSize=16;labelBackgroundColor=#ffffff;exitX=0.6667;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="d2n4" target="d2n11"><mxGeometry x="0.120" relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="626"/><mxPoint x="580" y="626"/></Array></mxGeometry></mxCell><mxCell id="d2e21" value="delivered" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=10;startArrow=none;strokeWidth=3;strokeColor=#000000;fontColor=#000000;rounded=0;fontSize=16;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="d2n9" target="d2n13"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="d2e22" value="red PC screen" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=10;startArrow=none;strokeWidth=3;strokeColor=#000000;fontColor=#000000;rounded=0;fontSize=16;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;" edge="1" parent="1" source="d2n11" target="d2n15"><mxGeometry x="0.000" relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="d2x23" value="LEVEL 2 — SIMULATE PACKETS (zoom into process 3)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="36" y="84" width="740" height="30" as="geometry"/></mxCell><mxCell id="d2lg24" value="&lt;b&gt;How to read these diagrams&lt;/b&gt;&lt;br&gt;Plain box (PLAYER) = external entity: someone outside the game system&lt;br&gt;Rounded box with a number = process: something the game does&lt;br&gt;Box open on the right with D1 / D2 = data store: where data is kept&lt;br&gt;Arrow = data flow; the label says what data moves&lt;br&gt;Dashed process = belongs to another level (process 4 is on page 1)&lt;br&gt;PLAYER is drawn more than once only to keep lines short" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=left;verticalAlign=middle;spacing=12;fontSize=15;" vertex="1" parent="1"><mxGeometry x="36" y="990" width="755" height="160" as="geometry"/></mxCell><mxCell id="d2ti25" value="DFD — Level 2" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="36" y="28" width="560" height="44" as="geometry"/></mxCell><mxCell id="d2pg26" value="Page 2 of 2" style="text;html=1;fontSize=15;align=right;verticalAlign=middle;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="641" y="28" width="150" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>