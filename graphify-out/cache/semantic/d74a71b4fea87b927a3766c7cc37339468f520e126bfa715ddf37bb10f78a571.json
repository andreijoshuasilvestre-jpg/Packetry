l, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_capstone_networking_game", "label": "Capstone Networking Game Prototype", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_unity6", "label": "Unity 6 (6000.4.1f1)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_urp", "label": "Universal Render Pipeline (URP)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_gameconcept", "label": "Educational Networking Game Concept & Design Philosophy", "file_type": "rationale", "rationale": "Core concepts (devices, cables, packet flow, CLI, subnet zones, level tasks) are fixed but execution/visual representation is flexible. Keep it simple and feasible - this is a capstone prototype, not a full simulator - but code for flexibility/scalability even at prototype stage, avoiding hardcoded special cases and keeping systems loosely coupled.", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_newinputsystem", "label": "Unity New Input System", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_manager_singleton_pattern", "label": "Manager Singleton Pattern (static Instance)", "file_type": "rationale", "rationale": "Each manager is a MonoBehaviour with a public static X Instance set in Awake() (self-destroys duplicates); managers coordinate through each other's Instance and public state rather than events.", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_input_priority_gate", "label": "Input-Priority Mutual-Exclusion Gate", "file_type": "rationale", "rationale": "DragDropManager owns the single input-priority gate, checking CLIPanelManager.IsOpen, CableManager.IsConnecting, CableRemoverManager.IsRemoving before handling clicks so only one interaction mode is ever 'live' at a time. Any new interaction mode must be added to this mutual-exclusion chain.", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_device_prefab_pipeline", "label": "ProBuilder Device Prefab Pipeline", "file_type": "rationale", "rationale": "DevicePrefabBuilder authors device geometry with ProBuilder's ShapeGenerator (used instead of an external DCC app like Blender), bakes parts into Mesh assets, and saves each device as a prefab. DeviceModelBuilder loads and Instantiates those prefabs via Resources.Load first, falling back to the original GameObject.CreatePrimitive()-based construction only if the prefab hasn't been generated yet, so the project still runs before the Editor tool has been run once.", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_table_procedural", "label": "Table Stays Procedural (not prefab-backed)", "file_type": "rationale", "rationale": "Table's footprint is chosen per-instance by the player at placement time, so it deliberately stays procedural in DeviceModelBuilder.BuildTable() rather than being prefab-backed like PC/Switch/Router.", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_routercli_state_machine", "label": "RouterCLI 4-Mode Cisco IOS State Machine", "file_type": "rationale", "rationale": "Implements a 4-mode command interpreter (UserExec -> PrivilegedExec -> GlobalConfig -> InterfaceConfig) mirroring real IOS prompts (>, #, (config)#, (config-if)#). Execute(string) returns null for silent success, '__CLOSE__' to signal the panel should close, or output text to display.", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_graphify_skill", "label": "graphify Claude Code Skill", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_probuilder_package", "label": "com.unity.probuilder (ProBuilder)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_textmeshpro", "label": "TextMeshPro", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_assembly_csharp", "label": "Assembly-CSharp", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_assembly_csharp_editor", "label": "Assembly-CSharp-Editor", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_pkg_urp_pipeline", "label": "com.unity.render-pipelines.universal 17.4.0", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_pkg_inputsystem", "label": "com.unity.inputsystem 1.19.0", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_pkg_ai_navigatio