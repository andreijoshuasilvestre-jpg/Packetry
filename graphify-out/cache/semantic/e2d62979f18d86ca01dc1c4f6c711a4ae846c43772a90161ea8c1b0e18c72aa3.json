{"nodes": [{"id": "claude_plans_what_is_a_good_polymorphic_meadow_cli_rework", "label": "CLI Rework: Simplified Interface Configuration + Onboarding", "file_type": "document", "source_file": ".claude/plans/what-is-a-good-polymorphic-meadow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_plans_what_is_a_good_polymorphic_meadow_mode_hierarchy", "label": "CLI Mode-Navigation Hierarchy (User EXEC -> Privileged EXEC -> Global Config -> Interface Config)", "file_type": "rationale", "rationale": "Kept because the hierarchy - 'go to a specific place to configure a specific thing' - is itself the lesson; cut everything real IOS has that doesn't serve that lesson (no speed/duplex/description, no realistic-but-arbitrary interface names like GigabitEthernet0/0).", "source_file": ".claude/plans/what-is-a-good-polymorphic-meadow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_plans_what_is_a_good_polymorphic_meadow_phase_a", "label": "Phase A: Functional Per-Device Ports + Interface Picker", "file_type": "rationale", "rationale": "Makes the already-cosmetic port-slot decorations on Router/Switch models functional, ties cabling to specific ports via a Packet-Tracer-style picker popup, so the CLI can later address those same ports as interfaces.", "source_file": ".claude/plans/what-is-a-good-polymorphic-meadow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_plans_what_is_a_good_polymorphic_meadow_phase_b", "label": "Phase B: Interface Configuration in RouterCLI", "file_type": "rationale", "rationale": "Adds an InterfaceConfig mode and per-port IP/mask/shutdown state; default shutdown=true matches real IOS - 'interfaces are down until configured' is kept as a deliberate, worthwhile lesson.", "source_file": ".claude/plans/what-is-a-good-polymorphic-meadow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_plans_what_is_a_good_polymorphic_meadow_phase_c", "label": "Phase C: Onboarding (Tab-Complete, Did-You-Mean, Help Panel)", "file_type": "rationale", "rationale": "Bundles Tab-completion, Levenshtein-based 'did you mean' suggestions, and an always-visible per-mode help panel so players learn the CLI without a separate tutorial system.", "source_file": ".claude/plans/what-is-a-good-polymorphic-meadow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_plans_what_is_a_good_polymorphic_meadow_phase_d", "label": "Phase D: Camera Focus, Floating World-Space CLI, Cable Highlight", "file_type": "rationale", "rationale": "Scoped to Router only since PC/Switch CLI has no real commands yet. Zooms the camera and floats the CLI panel in world space above the device (instead of a fixed centered overlay) so the device and its ports stay visible in frame, and highlights the cable plugged into the interface currently being configured.", "source_file": ".claude/plans/what-is-a-good-polymorphic-meadow.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_plans_what_is_a_good_polymorphic_meadow_cli_rework", "target": "assets_scripts_routercli_routercli", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/plans/what-is-a-good-polymorphic-meadow.md", "source_location": null, "weight": 1.0}, {"source": "claude_plans_what_is_a_good_polymorphic_meadow_cli_rework", "target": "assets_scripts_clipanelmanager_clipanelmanager", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/plans/what-is-a-good-polymorphic-meadow.md", "source_location": null, "weight": 1.0}, {"source": "claude_plans_what_is_a_good_polymorphic_meadow_cli