%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 13cb08e2f33c5ef4c9ee4ae9719e5226, type: 3}
  m_Name: LevelCatalog
  m_EditorClassIdentifier: Assembly-CSharp::LevelCatalog
  levels:
  - number: 1
    title: Device Connecting
    sceneName: SampleScene
    category: Tutorials
    description: 'Learn the basics: place a table, add two PCs and a Switch, then
      cable everything together into your first working network.'
    icons:
    - PC_Icon
    - Cable
  - number: 2
    title: IP Allocation
    sceneName: SampleScene
    category: Tutorials
    description: "Give two PCs IP addresses on the same subnet and get them talking
      \u2014 your first taste of addressing a network."
    icons:
    - PC_Icon
  - number: 3
    title: Router CLI Basics
    sceneName: SampleScene
    category: Tutorials
    description: "Open a Router's command line and learn to navigate its modes \u2014
      User EXEC, Privileged EXEC, Global Config, and Interface Config \u2014 the
      same way real Cisco IOS works."
    icons:
    - Router_Icon
  - number: 4
    title: Routers & Subnetting
    sceneName: SampleScene
    category: Tutorials
    description: 'Bridge two different subnets with a Router: address both PCs, configure
      each router interface, and get a cross-subnet ping working.'
    icons:
    - Router_Icon
    - PC_Icon
  - number: 5
    title: LAN Challenge
    sceneName: SampleScene
    category: Challenges
    description: "No hand-holding this time. Build a small LAN \u2014 two PCs and
      a Switch \u2014 entirely on your own and prove it works with a successful ping."
    icons:
    - PC_Icon
    - Switch_Icon
  - number: 6
    title: Two-LAN Challenge
    sceneName: SampleScene
    category: Challenges
    description: 'Scale it up: two switched departments bridged by a Router. Cable,
      address, and configure everything yourself to get a cross-router ping working.'
    icons:
    - PC_Icon
    - Switch_Icon
    - Router_Icon
  - number: 7
    title: Network Troubleshooting
    sceneName: SampleScene
    category: Challenges
    description: "A pre-built network is broken \u2014 an unplugged cable, a misaddressed
      PC, and a shut-down router interface. Find and fix all three faults using the
      tools you've already learned."
    icons:
    - Router_Icon
    - Ping
  - number: 8
    title: 'Free Build: Office LAN'
    sceneName: SampleScene
    category: Challenges
    description: A blank table and no prescribed layout. Place at least three PCs,
      wire and address them however you like, and get every PC talking to every other
      PC.
    icons:
    - PC_Icon
    - Switch_Icon
  - number: 9
    title: Multi-Department Network
    sceneName: SampleScene
    category: Challenges
    description: "Scale it up to three departments \u2014 six PCs, three Switches,
      and a Router using every one of its interfaces. Bigger table, same rules: cable,
      address, and route between all three subnets yourself."
    icons:
    - PC_Icon
    - Switch_Icon
    - Router_Icon
  - number: 10
    title: Resilience Challenge
    sceneName: SampleScene
    category: Challenges
    description: "Build a network that keeps working no matter which single cable
      gets cut. A straight chain won't survive \u2014 you'll need real redundancy
      in the backbone."
    icons:
    - Switch_Icon
    - Cable
  - number: 11
    title: 'VLSM: Multi-Site Network'
    sceneName: SampleScene
    category: Challenges
    description: Three departments, one shared address block. Instead of a fresh
      subnet each, carve 192.168.1.0/24 into three differently-sized pieces that
      actually fit what each department needs.
    icons:
    - Router_Icon
    - PC_Icon
    - Switch_Icon
